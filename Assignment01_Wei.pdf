.090196 .129412 .168627 rg
BT 1 0 0 1 4 143.8 Tm /F3 8.3 Tf 11.7 TL (ALGORITHM INSERTION-SORT\(A\)) Tj T* (    n <- length\(A\)) Tj T* (    for i <- 1 to n - 1 do) Tj T* (        key <- A[i]) Tj T* (        j <- i - 1) Tj T* (        while j >= 0 and A[j] > key do) Tj T* (            A[j + 1] <- A[j]) Tj T* (            j <- j - 1) Tj T* (        end while) Tj T* (        A[j + 1] <- key) Tj T* (    end for) Tj T* (    return A) Tj T* (END ALGORITHM) Tj T* ET
Q
