BT 1 0 0 1 4 178.9 Tm /F3 8.3 Tf 11.7 TL (ALGORITHM BUBBLE-SORT\(A\)) Tj T* (    n <- length\(A\)) Tj T* (    for pass <- 0 to n - 2 do) Tj T* (        swapped <- false) Tj T* (        for i <- 0 to n - pass - 2 do) Tj T* (            if A[i] > A[i + 1] then) Tj T* (                swap\(A[i], A[i + 1]\)) Tj T* (                swapped <- true) Tj T* (            end if) Tj T* (        end for) Tj T* (        if swapped = false then) Tj T* (            break) Tj T* (        end if) Tj T* (    end for) Tj T* (    return A) Tj T* (END ALGORITHM) Tj T* ET
