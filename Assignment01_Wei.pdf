BT 1 0 0 1 4 366.1 Tm /F3 8.3 Tf 11.7 TL (ALGORITHM MERGE-SORT\(A, low, high\)) Tj T* (    if low < high then) Tj T* (        mid <- floor\(\(low + high\) / 2\)) Tj T* (        MERGE-SORT\(A, low, mid\)) Tj T* (        MERGE-SORT\(A, mid + 1, high\)) Tj T* (        MERGE\(A, low, mid, high\)) Tj T* (    end if) Tj T* (END ALGORITHM) Tj T*  T* (ALGORITHM MERGE\(A, low, mid, high\)) Tj T* (    L <- copy of A[low .. mid]) Tj T* (    R <- copy of A[mid + 1 .. high]) Tj T* (    i <- 0; j <- 0; k <- low) Tj T* (    while i < length\(L\) and j < length\(R\) do) Tj T* (        if L[i] <= R[j] then) Tj T* (            A[k] <- L[i]) Tj T* (            i <- i + 1) Tj T* (        else) Tj T* (            A[k] <- R[j]) Tj T* (            j <- j + 1) Tj T* (        end if) Tj T* (        k <- k + 1) Tj T* (    end while) Tj T* (    while i < length\(L\) do) Tj T* (        A[k] <- L[i]) Tj T* (        i <- i + 1; k <- k + 1) Tj T* (    end while) Tj T* (    while j < length\(R\) do) Tj T* (        A[k] <- R[j]) Tj T* (        j <- j + 1; k <- k + 1) Tj T* (    end while) Tj T* (END ALGORITHM) Tj T* ET
Q
