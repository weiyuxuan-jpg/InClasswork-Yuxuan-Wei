%PreformattedPara
.090196 .129412 .168627 rg
BT 1 0 0 1 4 284.2 Tm /F3 8.3 Tf 11.7 TL (ALGORITHM HEAP-SORT\(A\)) Tj T* (    n <- length\(A\)) Tj T* (    for i <- floor\(n / 2\) - 1 downto 0 do) Tj T* (        SIFT-DOWN\(A, i, n\)) Tj T* (    end for) Tj T* (    for end <- n - 1 downto 1 do) Tj T* (        swap\(A[0], A[end]\)) Tj T* (        SIFT-DOWN\(A, 0, end\)) Tj T* (    end for) Tj T* (    return A) Tj T* (END ALGORITHM) Tj T*  T* (ALGORITHM SIFT-DOWN\(A, root, size\)) Tj T* (    while 2 * root + 1 < size do) Tj T* (        child <- 2 * root + 1) Tj T* (        if child + 1 < size and A[child + 1] > A[child] then) Tj T* (            child <- child + 1) Tj T* (        end if) Tj T* (        if A[root] >= A[child] then) Tj T* (            break) Tj T* (        end if) Tj T* (        swap\(A[root], A[child]\)) Tj T* (        root <- child) Tj T* (    end while) Tj T* (END ALGORITHM) Tj T* ET
Q
