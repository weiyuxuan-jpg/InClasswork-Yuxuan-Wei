%PreformattedPara
.090196 .129412 .168627 rg
BT 1 0 0 1 4 167.2 Tm /F3 8.3 Tf 11.7 TL (ALGORITHM SELECTION-SORT\(A\)) Tj T* (    n <- length\(A\)) Tj T* (    for i <- 0 to n - 2 do) Tj T* (        minIdx <- i) Tj T* (        for j <- i + 1 to n - 1 do) Tj T* (            if A[j] < A[minIdx] then) Tj T* (                minIdx <- j) Tj T* (            end if) Tj T* (        end for) Tj T* (        if minIdx != i then) Tj T* (            swap\(A[i], A[minIdx]\)) Tj T* (        end if) Tj T* (    end for) Tj T* (    return A) Tj T* (END ALGORITHM) Tj T* ET
Q
