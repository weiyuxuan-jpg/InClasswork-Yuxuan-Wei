1 0 0 1 57.84 413.04 cm
%PreformattedPara
.090196 .129412 .168627 rg
BT 1 0 0 1 4 225.7 Tm /F3 8.3 Tf 11.7 TL (ALGORITHM QUICK-SORT\(A, low, high\)) Tj T* (    if low < high then) Tj T* (        p <- PARTITION\(A, low, high\)) Tj T* (        QUICK-SORT\(A, low, p - 1\)) Tj T* (        QUICK-SORT\(A, p + 1, high\)) Tj T* (    end if) Tj T* (END ALGORITHM) Tj T*  T* (ALGORITHM PARTITION\(A, low, high\)) Tj T* (    pivot <- A[high]) Tj T* (    i <- low - 1) Tj T* (    for j <- low to high - 1 do) Tj T* (        if A[j] <= pivot then) Tj T* (            i <- i + 1) Tj T* (            swap\(A[i], A[j]\)) Tj T* (        end if) Tj T* (    end for) Tj T* (    swap\(A[i + 1], A[high]\)) Tj T* (    return i + 1) Tj T* (END ALGORITHM) Tj T* ET
